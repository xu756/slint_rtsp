import { VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";
import "../static/DingTalk-JinBuTi.ttf";
import { LogMessage, AlarmMessage } from "structs.slint";
import { TopBar } from "top_bar.slint";
import { BottomBar } from "bottom_bar.slint";
import { VideoPane } from "video_pane.slint";
import { LogsPane } from "logs_pane.slint";

export { LogMessage, AlarmMessage }
export component App inherits Window {
    callback quit-requested();

    in property <image> video-frame <=> video-pane.video-frame;
    in property <string> stream-error;

    in property <string> system-time: "2025-05-29 16:48:30";
    in property <string> cpu-usage: "28%";
    in property <string> mem-usage: "512MB";
    in property <string> net-usage: "2.3Mbps";

    in property <string> video-resolution: "1920x1080";
    in property <string> video-fps: "30";
    in property <string> video-codec: "H.264";
    in property <string> video-latency: "120ms";
    in property <string> video-url: "rtsp://192.168.1.123:8554/mystream";
    default-font-family: "DingTalk JinBuTi";
    in property <int> alarm-count: 12;
    in property <int> log-count: 120;

    in property <[LogMessage]> logs: [
        {
            time: "16:47:58",
            level: "INFO",
            message: "已连接到流媒体服务器",
            detail: "RTSP/RTMP 流媒体连接建立成功，正在等待首帧数据。",
            image_url: "https://picsum.photos/seed/rtsp-log/720/405",
            snapshot: @image-url(""),
        },
        {
            time: "16:48:05",
            level: "WARN",
            message: "网络延迟较高: 120ms",
            detail: "链路延迟超过预设阈值，建议检查推流端、交换机和服务器负载。",
            image_url: "https://picsum.photos/seed/rtsp-log/720/405",
            snapshot: @image-url(""),
        },
        {
            time: "16:48:10",
            level: "INFO",
            message: "帧率稳定",
            detail: "最近 10 秒内帧率波动保持在正常范围。",
            image_url: "https://picsum.photos/seed/rtsp-log/720/405",
            snapshot: @image-url(""),
        },
    ];

    in property <[AlarmMessage]> alarms: [
        {
            time: "16:48:25",
            level: "高危",
            message: "人员闯入检测",
            status: "未处理",
            detail: "检测区域 A-03 出现人员闯入，目标停留超过阈值。请核验现场画面并尽快处理。",
            image_url: "https://picsum.photos/seed/rtsp-alarm/720/405",
            snapshot: @image-url(""),
        },
        {
            time: "16:47:30",
            level: "中危",
            message: "区域入侵检测",
            status: "未处理",
            detail: "周界区域出现移动目标，系统已截取触发帧用于复核。",
            image_url: "https://picsum.photos/seed/rtsp-alarm/720/405",
            snapshot: @image-url(""),
        },
        {
            time: "16:45:12",
            level: "低危",
            message: "移动物体检测",
            status: "已处理",
            detail: "画面左侧出现短时移动目标，已完成人工确认并归档。",
            image_url: "https://picsum.photos/seed/rtsp-alarm/720/405",
            snapshot: @image-url(""),
        },
    ];

    preferred-width: 1366px;
    preferred-height: 768px;
    min-width: 1024px;
    min-height: 600px;
    title: "智能监控终端";
    background: #f0f2f5;

    init => {
        Palette.color-scheme = ColorScheme.light;
    }

    VerticalBox {
        padding: 16px;
        spacing: 16px;

        TopBar {
            system-time: root.system-time;
            stream-error: root.stream-error;
            video-url: root.video-url;
            close-requested => {
                root.quit-requested();
            }
        }

        HorizontalBox {
            padding: 0px;
            spacing: 16px;

            video_pane := VideoPane {
                video-resolution: root.video-resolution;
                video-fps: root.video-fps;
                video-codec: root.video-codec;
                video-latency: root.video-latency;
                stream-error: root.stream-error;
                video-url: root.video-url;
            }

            LogsPane {
                logs: root.logs;
                log-count: root.log-count;
                alarms: root.alarms;
                alarm-count: root.alarm-count;
            }
        }

        BottomBar {
            cpu-usage: root.cpu-usage;
            mem-usage: root.mem-usage;
            net-usage: root.net-usage;
        }
    }
}
